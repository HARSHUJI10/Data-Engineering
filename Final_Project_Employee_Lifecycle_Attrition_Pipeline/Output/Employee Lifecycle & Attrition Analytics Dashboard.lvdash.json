{
  "datasets": [
    {
      "name": "employee_dept_metrics",
      "displayName": "Employee Department Metrics",
      "queryLines": [
        "SELECT\n",
        "  department,\n",
        "  COUNT(*) as employee_count,\n",
        "  AVG(salary) as average_salary\n",
        "FROM\n",
        "  workspace.employee_data.silver_employee\n",
        "WHERE\n",
        "  status = 'Active'\n",
        "GROUP BY\n",
        "  department\n",
        "ORDER BY\n",
        "  department"
      ]
    },
    {
      "name": "dept_tenure",
      "displayName": "Department Tenure",
      "queryLines": [
        "SELECT\n",
        "  department,\n",
        "  avg_tenure_years,\n",
        "  employee_count as count\n",
        "FROM\n",
        "  workspace.employee_data.gold_avg_tenure\n",
        "ORDER BY\n",
        "  department"
      ]
    },
    {
      "name": "attrition_trend",
      "displayName": "Attrition Trend",
      "queryLines": [
        "SELECT\n",
        "  snapshot_date,\n",
        "  attrition_rate_pct\n",
        "FROM\n",
        "  workspace.employee_data.gold_attrition_rate\n",
        "ORDER BY\n",
        "  snapshot_date"
      ]
    }
  ],
